{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM"],
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "skipLibCheck": true,
    "strict": true,
    "noEmit": true,
    "tsBuildInfoFile": "./node_modules/.cache/tsconfig.api.tsbuildinfo",
    "isolatedModules": true,
    "moduleDetection": "force",
    "types": ["node"]
  },
  "include": [
    "api",
    "server",
    "src/data/questionnaire.ts",
    "src/data/report.ts",
    "src/lib/age.ts",
    "src/lib/questionnaire-state.ts",
    "src/lib/report-generation-constraints.ts",
    "src/lib/report-generation-input.ts",
    "src/lib/report-schemas.ts"
  ]
}
